{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunRecord",
  "type": "object",
  "required": [
    "run_id",
    "dataset",
    "decision_state_dataset",
    "model",
    "policy",
    "constraints",
    "decisions",
    "approvals",
    "receipts",
    "metrics"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "dataset": { "$ref": "#/$defs/datasetSnapshot" },
    "decision_state_dataset": { "$ref": "#/$defs/stateSnapshot" },
    "model": { "$ref": "#/$defs/componentMetadata" },
    "policy": { "$ref": "#/$defs/componentMetadata" },
    "constraints": {
      "type": "object",
      "required": [
        "max_units",
        "max_spend",
        "min_order_qty",
        "service_level",
        "approval_spend_threshold",
        "allow_external_write"
      ],
      "properties": {
        "max_units": { "type": "number", "exclusiveMinimum": 0 },
        "max_spend": { "type": "number", "minimum": 0 },
        "min_order_qty": { "type": "number", "exclusiveMinimum": 0 },
        "service_level": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "approval_spend_threshold": { "type": "number", "minimum": 0 },
        "allow_external_write": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "decisions": {
      "type": "array",
      "items": { "$ref": "decision.schema.json" }
    },
    "approvals": {
      "type": "array",
      "items": { "$ref": "approval_record.schema.json" }
    },
    "receipts": {
      "type": "array",
      "items": { "$ref": "execution_receipt.schema.json" }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "result_summary": {
      "type": "object",
      "required": ["aggregate", "items"],
      "properties": {
        "aggregate": {
          "type": "object",
          "required": ["forecast_p50", "forecast_p90", "recommended_order_qty", "expected_cost", "stockout_risk", "approval_required", "constraint_status"],
          "properties": {
            "forecast_p50": { "type": "number", "minimum": 0 },
            "forecast_p90": { "type": "number", "minimum": 0 },
            "recommended_order_qty": { "type": "number", "minimum": 0 },
            "expected_cost": { "type": "number", "minimum": 0 },
            "stockout_risk": { "type": "number", "minimum": 0, "maximum": 1 },
            "approval_required": { "type": "boolean" },
            "constraint_status": { "enum": ["passed", "partial", "rejected"] }
          },
          "additionalProperties": false
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["business_unit_id", "store_id", "node_id", "sku_id", "forecast_p50", "forecast_p90", "recommended_order_qty", "expected_cost", "decision_id"],
            "properties": {
              "business_unit_id": { "type": "string" },
              "store_id": { "type": "string" },
              "node_id": { "type": "string" },
              "sku_id": { "type": "string" },
              "forecast_p50": { "type": "number", "minimum": 0 },
              "forecast_p90": { "type": "number", "minimum": 0 },
              "recommended_order_qty": { "type": "number", "minimum": 0 },
              "expected_cost": { "type": "number", "minimum": 0 },
              "decision_id": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "model_output": { "$ref": "model_output.schema.json" }
  },
  "$defs": {
    "componentMetadata": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "stateSnapshot": {
      "type": "object",
      "required": ["dataset_id", "version", "snapshot_time"],
      "properties": {
        "dataset_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "snapshot_time": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "datasetSnapshot": {
      "type": "object",
      "required": ["dataset_id", "version", "snapshot_time", "quality"],
      "properties": {
        "dataset_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "snapshot_time": { "type": "string", "format": "date-time" },
        "quality": {
          "type": "object",
          "required": ["total_rows", "valid_rows", "errors"],
          "properties": {
            "total_rows": { "type": "integer", "minimum": 0 },
            "valid_rows": { "type": "integer", "minimum": 0 },
            "errors": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
