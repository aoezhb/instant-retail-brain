{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DemandRecord",
  "type": "object",
  "required": ["business_unit_id", "store_id", "node_id", "sku_id", "day", "demand"],
  "properties": {
    "business_unit_id": { "type": "string", "minLength": 1 },
    "store_id": { "type": "string", "minLength": 1 },
    "node_id": { "type": "string", "minLength": 1 },
    "sku_id": { "type": "string", "minLength": 1 },
    "day": { "type": "string", "format": "date" },
    "demand": { "type": "number", "minimum": 0 },
    "available": { "type": "boolean", "default": true },
    "event_time": { "type": "string", "format": "date-time" },
    "available_time": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
